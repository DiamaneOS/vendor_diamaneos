# DiamaneOS: fsvmd serves an SD card or USB drive to Android through FUSE, with the filesystem parsed only inside a
# protected VM (fsvm/, system/vold fs/Fsvm.cpp). Each rule below is what that path needs and nothing more.
type fsvmd, domain, coredomain;
type fsvmd_exec, system_file_type, exec_type, file_type;
type fsvmd_tmpfs, file_type;
type fsvmd_socket, file_type, coredomain_socket;

# init runs the fsvmd service (fsvmd_launcher, fsvmd.rc) as the system user without capabilities, in a domain of its
# own. vold asks it over its socket for one fsvmd per probe, volume or OBB image, and the service starts it
# (fsvmd/src/launcher.rs), so vold changes no ids and holds neither setuid nor setgid. vold stops fsvmd through the
# service. Only vold may connect, and a fsvmd can neither signal nor trace the service.
type fsvmd_launcher, domain, coredomain;
type fsvmd_launcher_exec, system_file_type, exec_type, file_type;
init_daemon_domain(fsvmd_launcher)
domain_auto_trans(fsvmd_launcher, fsvmd_exec, fsvmd)
allow fsvmd_launcher self:unix_stream_socket { accept listen read write getopt shutdown };
allow fsvmd_launcher fsvmd:process { signal sigkill };
allow fsvmd fsvmd_launcher:process sigchld;
allow fsvmd fsvmd_launcher:fd use;
unix_socket_connect(vold, fsvmd, fsvmd_launcher)
# The descriptors vold sends with a request pass through the service to the fsvmd it starts.
allow fsvmd_launcher vold:fd use;
allow fsvmd_launcher vold:fifo_file write;
allow fsvmd_launcher vold_device:blk_file { read write getattr };
allow fsvmd_launcher fuse_device:chr_file { read write getattr };
allow fsvmd_launcher { media_rw_data_file fuse }:file { read getattr };
# OBB images are served by fsvmd_obb (fsvmd_obb.te), never by fsvmd.
# The service may connect to its own sockets as every domain may (domain.te), vold to its socket.
neverallow { domain -vold -fsvmd_launcher } fsvmd_launcher:unix_stream_socket connectto;
neverallow { domain -vold -init } fsvmd_socket:sock_file write;
neverallow { domain -init } fsvmd_launcher:process transition;
neverallow { domain -fsvmd_launcher } fsvmd:process transition;
neverallow fsvmd fsvmd_launcher:process { signal sigkill sigstop ptrace };
neverallow fsvmd_launcher { vold_device fuse_device }:{ blk_file chr_file } open;
neverallow fsvmd_launcher { media_rw_data_file fuse }:file { open write append };
neverallow vold self:global_capability_class_set { setuid setgid };

# The descriptors vold hands over through the socket: the volume's block device (3), the /dev/fuse descriptor it
# mounted at /mnt/media_rw/<uuid> (4) and the pipe fsvmd reports readiness on (5). fsvmd itself never reads the
# volume.
allow fsvmd vold:fd use;
allow fsvmd vold:fifo_file write;
# The kernel checks a descriptor against its open mode when fsvmd inherits it and when fsvmd passes it on over binder,
# so fsvmd holds read and write on the disk it was handed, though it never reads it itself. It cannot open one.
allow fsvmd vold_device:blk_file { read write getattr };
allow fsvmd fuse_device:chr_file { read write getattr };

# The guest kernel and initramfs in the virtualization APEX.
allow fsvmd system_file:file { open read getattr };

# The VM's instance disk is a memfd, read and written by fsvmd's own VM manager and crosvm.
tmpfs_domain(fsvmd)

# fsvmd starts the filesystem VM through its own VM manager and talks to it over vsock.
virtualizationservice_use(fsvmd)
allow { fsvmd_virtualizationmanager fsvmd_virtmgr_crosvm } fsvmd_tmpfs:file { read write getattr };
# Only fsvmd's VM manager and crosvm get the volume, through the descriptor vold opened. crosvm reads and writes it
# as the VM's raw disk. The VM manager checks its label and passes it on, which needs the open mode's permissions.
allow { fsvmd_virtualizationmanager fsvmd_virtmgr_crosvm } vold:fd use;
allow fsvmd_virtualizationmanager vold_device:blk_file { read write getattr };
allow fsvmd_virtmgr_crosvm vold_device:blk_file { read write getattr };

# Phase 2: Android's kernel reads no partition table of an SD card or USB disk (CONFIG_BLK_NO_EXTERNAL_PART_SCAN).
# vold, and only vold, adds a partition to it with BLKPG: the adoptable storage partition, a public volume's
# partition next to it on a mixed card (so that the VM gets only that range), and a public volume's partition for a
# format, at the range the filesystem VM read and fsvmd checked. The kernel allows two such partitions per disk at a
# time and refuses rescans and resizing.
allowxperm vold vold_device:blk_file ioctl BLKPG;
# blkid_untrusted holds ioctl on vold_device without an ioctl list, but no CAP_SYS_ADMIN, which BLKPG needs. The
# kernel's own nodes of a USB disk carry block_device (init holds ioctl on every device node).
neverallowxperm { domain -vold -blkid_untrusted -init } { vold_device block_device }:blk_file ioctl BLKPG;
neverallow blkid_untrusted self:global_capability_class_set sys_admin;

# An app's OBB image is served by fsvmd_obb (fsvmd_obb.te), from shared storage or a card. fsvmd, which serves the
# cards themselves, holds no right on OBB files, and none of its domains may open a card or an app's file itself.
neverallow { fsvmd fsvmd_virtualizationmanager fsvmd_virtmgr_crosvm } { media_rw_data_file fuse }:file { open write append };
neverallow { fsvmd fsvmd_virtualizationmanager fsvmd_virtmgr_crosvm } vold_device:blk_file open;

# A USB disk with 4096-byte logical blocks keeps them in the VM: fsvmd's VM manager reads the block size of the disk
# it was handed, and only that.
allow fsvmd_virtualizationmanager vold_device:blk_file ioctl;
allowxperm fsvmd_virtualizationmanager vold_device:blk_file ioctl BLKSSZGET;
