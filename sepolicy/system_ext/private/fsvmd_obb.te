# DiamaneOS: fsvmd_obb serves an app's OBB image read-only from the filesystem VM (fsvm/, system/vold
# model/ObbVolume.cpp). The same program as fsvmd, from its own binary so that it has a domain of its own: no access to
# SD cards or USB drives at all.
type fsvmd_obb, domain, coredomain;
type fsvmd_obb_exec, system_file_type, exec_type, file_type;
type fsvmd_obb_tmpfs, file_type;

# The OBB slots' fsvmd service starts it for vold (fsvmd/src/launcher.rs), and only that service. It is the card
# slots' program from a binary of its own (fsvmd_obb_launcher, fsvmd.rc), so that it holds no right on cards: the
# descriptors it passes on are an OBB file, a /dev/fuse descriptor and a pipe.
type fsvmd_obb_launcher, domain, coredomain;
type fsvmd_obb_launcher_exec, system_file_type, exec_type, file_type;
init_daemon_domain(fsvmd_obb_launcher)
domain_auto_trans(fsvmd_obb_launcher, fsvmd_obb_exec, fsvmd_obb)
allow fsvmd_obb_launcher self:unix_stream_socket { accept listen read write getopt shutdown };
allow fsvmd_obb_launcher self:process setcap;
allow fsvmd_obb_launcher fsvmd_obb:process { signal sigkill };
allow fsvmd_obb_launcher { fsvmd_obb_virtualizationmanager fsvmd_obb_virtmgr_crosvm }:process sigkill;
allow fsvmd_obb fsvmd_obb_launcher:process sigchld;
allow fsvmd_obb fsvmd_obb_launcher:fd use;
unix_socket_connect(vold, fsvmd, fsvmd_obb_launcher)
allow fsvmd_obb_launcher vold:fd use;
allow fsvmd_obb_launcher vold:fifo_file write;
allow fsvmd_obb_launcher fuse_device:chr_file { read write getattr };
allow fsvmd_obb_launcher { media_rw_data_file fuse }:file { read getattr };
neverallow { domain -vold -fsvmd_obb_launcher } fsvmd_obb_launcher:unix_stream_socket connectto;
neverallow { domain -init } fsvmd_obb_launcher:process transition;
neverallow { domain -fsvmd_obb_launcher } fsvmd_obb:process transition;
neverallow fsvmd_obb fsvmd_obb_launcher:process { signal sigkill sigstop ptrace };
neverallow fsvmd_obb_launcher vold_device:blk_file *;
neverallow fsvmd_obb_launcher fuse_device:chr_file open;
neverallow fsvmd_obb_launcher { media_rw_data_file fuse }:file { open write append };
neverallow fsvmd_obb_launcher fsvmd_exec:file { execute execute_no_trans };

# The descriptors vold hands over: the OBB file (3), read-only, from shared storage (media_rw_data_file) or a card's
# FUSE mount (fuse), the /dev/fuse descriptor it mounted at /mnt/obb/<id> (4) and the pipe it reports readiness on
# (5). The VM manager checks the file's label and passes it on, crosvm reads it raw as the VM's disk.
allow fsvmd_obb vold:fd use;
allow fsvmd_obb vold:fifo_file write;
allow fsvmd_obb fuse_device:chr_file { read write getattr };
allow fsvmd_obb { media_rw_data_file fuse }:file { read getattr };

# The guest kernel and initramfs in the virtualization APEX.
allow fsvmd_obb system_file:file { open read getattr };

# The VM's instance disk is a memfd, read and written by its VM manager and crosvm.
tmpfs_domain(fsvmd_obb)
virtualizationservice_use(fsvmd_obb)
# The same client as fsvmd: its timeouts on the vsock socket its VM manager made, and its shutdown when a session ends.
allow fsvmd_obb fsvmd_obb_virtualizationmanager:vsock_socket { setopt shutdown };
allow { fsvmd_obb_virtualizationmanager fsvmd_obb_virtmgr_crosvm } fsvmd_obb_tmpfs:file { read write getattr };
allow { fsvmd_obb_virtualizationmanager fsvmd_obb_virtmgr_crosvm } vold:fd use;
allow { fsvmd_obb_virtualizationmanager fsvmd_obb_virtmgr_crosvm } { media_rw_data_file fuse }:file { read getattr };

# Read-only, and never a card.
neverallow { fsvmd_obb fsvmd_obb_virtualizationmanager fsvmd_obb_virtmgr_crosvm } { media_rw_data_file fuse }:file { open write append };
neverallow { fsvmd_obb fsvmd_obb_virtualizationmanager fsvmd_obb_virtmgr_crosvm } vold_device:blk_file *;

# The OBB VM's RAM comes from the boot pool for protected VMs when it has room (the device's gunyah_vm_pool.te declares
# the attributes), else ordinary memory. vold stops an OBB image's VM when a drive needs its room.
typeattribute fsvmd_obb_virtualizationmanager gunyah_vm_pool_client;
typeattribute fsvmd_obb_virtmgr_crosvm gunyah_vm_pool_crosvm;
