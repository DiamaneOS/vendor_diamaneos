# Tally in SystemUI. The flag is fixed read-only, so this is a build-time
# switch: no setting on the phone can change it.
flag_value {
  package: "de.diamaneos.systemui"
  name: "tally_shell"
  state: ENABLED
  permission: READ_ONLY
}
