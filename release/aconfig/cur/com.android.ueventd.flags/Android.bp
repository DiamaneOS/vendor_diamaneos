// ueventd's cold boot runs in forked workers, as in Android 16, not in
// Android 17's thread pool. The thread pool can label /dev/ashmem<boot_id>
// with a truncated SELinux context. The node then falls back to the generic
// device label and system_server cannot start. ueventd ignores a failed
// setfscreatecon and never re-checks a new node, so the error is silent.
// Forked workers cost a few tens of milliseconds of boot.
aconfig_values {
    name: "aconfig-values-diamaneos-cur-com.android.ueventd.flags-all",
    package: "com.android.ueventd.flags",
    srcs: [
        "*_flag_values.textproto",
    ],
}
