# Trash: Delete would move files to a trash instead of deleting them.
# Off until retention, purge, visibility to other apps and profiles, and
# clearing by erase are reviewed and tested.
flag_value {
  package: "com.android.documentsui.flags"
  name: "enable_trash_flow_ro"
  state: DISABLED
  permission: READ_ONLY
}
