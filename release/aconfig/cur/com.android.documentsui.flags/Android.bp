// Files (DocumentsUI) ships its Material 3 look (the force_material3
// overlay). The new archive code (zip_ng_ro) is on. The trash flow
// (enable_trash_flow_ro) is off, because its retention, cross-app and
// cross-profile isolation and erase behaviour have no review.
aconfig_values {
    name: "aconfig-values-diamaneos-cur-com.android.documentsui.flags-all",
    package: "com.android.documentsui.flags",
    srcs: [
        "*_flag_values.textproto",
    ],
}
