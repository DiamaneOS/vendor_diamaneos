# New archive code (ZIP/7z/tar browsing, creation and extraction), on. From
# its security review and host fuzzing: path traversal and
# zip-slip are collapsed to the extraction root by Archive.getEntryPath and
# extraction is SAF-mediated, archive symlink entries are never followed,
# extraction size is bounded (per-file to the declared size and in total to the
# pre-checked free space), and mutational fuzzing of the parser found no crash,
# hang or unbounded allocation.
flag_value {
  package: "com.android.documentsui.flags"
  name: "zip_ng_ro"
  state: ENABLED
  permission: READ_ONLY
}
