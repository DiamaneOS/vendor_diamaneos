// Notification rows show each app's icon themed in one colour, as Home's keys
// are. Only SystemUI's notification icon provider
// reads this flag.
aconfig_values {
    name: "aconfig-values-diamaneos-cur-android.app-all",
    package: "android.app",
    srcs: [
        "*_flag_values.textproto",
    ],
}
