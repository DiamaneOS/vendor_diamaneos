// The status bar privacy chip animates in for location, as for the camera and
// microphone. Only SystemUI's SystemEventCoordinator reads
// location_indicators_animation.
aconfig_values {
    name: "aconfig-values-diamaneos-cur-android.location.flags-all",
    package: "android.location.flags",
    srcs: [
        "*_flag_values.textproto",
    ],
}
