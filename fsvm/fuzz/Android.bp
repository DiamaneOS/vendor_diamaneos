// Fuzzing of what a filesystem VM sends back, on the host: fsvm_proto's decoders, its checking client and fsvmd's
// FUSE translation (../fsvmd/src/fs.rs, compiled as it is) against scripted VMs. libFuzzer with the address
// sanitizer. The corpora under corpus/ come from the protocol's encoders (src/seeds.rs) and the fuzzers' runs, and
// fsvm_fuzz_corpus_test replays them as regression tests.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_fuzz_host {
    name: "fsvm_proto_fuzzer",
    crate_name: "fsvm_proto_fuzzer",
    crate_root: "src/proto_fuzzer.rs",
    srcs: [
        "src/proto_fuzzer.rs",
        "src/vm_replies.rs",
    ],
    edition: "2021",
    rustlibs: ["libfsvm_proto"],
    corpus: ["corpus/proto/*"],
}

rust_fuzz_host {
    name: "fsvm_client_fuzzer",
    crate_name: "fsvm_client_fuzzer",
    crate_root: "src/client_fuzzer.rs",
    srcs: [
        "src/client_fuzzer.rs",
        "src/vm_replies.rs",
    ],
    edition: "2021",
    rustlibs: ["libfsvm_proto"],
    corpus: ["corpus/client/*"],
}

rust_defaults {
    name: "fsvmd_fs_fuzz_defaults",
    edition: "2021",
    rustlibs: [
        "libanyhow",
        "libfsvm_proto",
        "libfuse_rust",
        "liblibc",
        "liblog_rust",
    ],
}

rust_fuzz_host {
    name: "fsvmd_fs_fuzzer",
    crate_name: "fsvmd_fs_fuzzer",
    defaults: ["fsvmd_fs_fuzz_defaults"],
    crate_root: "src/fs_fuzzer.rs",
    srcs: [
        "src/fs_fuzzer.rs",
        "src/fs_target.rs",
        "src/vm_replies.rs",
        ":fsvmd_fs_src",
    ],
    corpus: ["corpus/fs/*"],
}

rust_test_host {
    name: "fsvm_fuzz_corpus_test",
    crate_name: "fsvm_fuzz_corpus_test",
    defaults: ["fsvmd_fs_fuzz_defaults"],
    crate_root: "src/replay_test.rs",
    srcs: [
        "src/replay_test.rs",
        "src/fs_target.rs",
        "src/seeds.rs",
        "src/vm_replies.rs",
        ":fsvmd_fs_src",
    ],
    data: ["corpus/**/*"],
    test_suites: ["general-tests"],
}
