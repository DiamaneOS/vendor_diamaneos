# DiamaneOS: vold asks this service for one fsvmd per probe, SD card or USB volume, or OBB image (system/vold
# fs/Fsvm.cpp, fsvmd/src/launcher.rs). It runs as the system user without capabilities, and so does every fsvmd it
# starts, so vold changes no ids. Only vold may connect to its socket (fsvmd.te). It is kept clear of the low memory
# killer: its death ends every served card. SYS_NICE only stays in the bounding set: the VM manager and crosvm carry
# it as a file capability, and the kernel refuses to execute them without it there (EPERM). The service drops it from
# every other set at its start (launcher_main.rs).
service fsvmd /system_ext/bin/fsvmd_launcher
    class core
    user system
    group system
    capabilities SYS_NICE
    socket fsvmd seqpacket 0600 root root
    oom_score_adjust -600
