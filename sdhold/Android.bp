// A new SD card waits while the phone is locked: init writes the lock state the system server
// sets to the kernel's hold of new cards.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

prebuilt_etc {
    name: "hold_new_sd.rc",
    src: "hold_new_sd.rc",
    sub_dir: "init",
    system_ext_specific: true,
}
