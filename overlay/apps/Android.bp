// Tally colour overlays for first-party apps, installed on the product
// partition for every device. They change colours, styles and drawables only:
// no strings, booleans, integers, arrays or layouts. apps.mk lists them.

runtime_resource_overlay {
    name: "DiamaneOSDialerOverlay",
    product_specific: true,
    manifest: "DiamaneOSDialerOverlay/AndroidManifest.xml",
    resource_dirs: ["DiamaneOSDialerOverlay/res"],
}

runtime_resource_overlay {
    name: "DiamaneOSContactsOverlay",
    product_specific: true,
    manifest: "DiamaneOSContactsOverlay/AndroidManifest.xml",
    resource_dirs: ["DiamaneOSContactsOverlay/res"],
}

runtime_resource_overlay {
    name: "DiamaneOSLatinIMEOverlay",
    product_specific: true,
    manifest: "DiamaneOSLatinIMEOverlay/AndroidManifest.xml",
    resource_dirs: ["DiamaneOSLatinIMEOverlay/res"],
}

runtime_resource_overlay {
    name: "DiamaneOSBluetoothOverlay",
    product_specific: true,
    manifest: "DiamaneOSBluetoothOverlay/AndroidManifest.xml",
    resource_dirs: ["DiamaneOSBluetoothOverlay/res"],
}
