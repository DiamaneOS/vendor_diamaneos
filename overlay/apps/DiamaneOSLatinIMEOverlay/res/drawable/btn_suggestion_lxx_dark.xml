     A pressed suggestion on the dark keyboard: the press layer as a rounded key.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="4dp" android:bottom="4dp" android:left="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="@android:color/system_control_highlight_dark" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
