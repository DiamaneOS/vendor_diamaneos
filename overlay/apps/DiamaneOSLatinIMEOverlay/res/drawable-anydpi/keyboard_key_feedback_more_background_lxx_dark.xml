<?xml version="1.0" encoding="utf-8"?>
<!--
     SPDX-License-Identifier: Apache-2.0
     Copyright 2026 The DiamaneOS Project

     The key preview above a pressed key: a raised keycap with a hairline edge.
     Its outer size (56 x 77.67 dp) and padding (4, 2, 4 and 63.67 dp) are the
     stock drawable's: the keyboard fits the preview text to them.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="4dp"
    android:insetTop="2dp"
    android:insetRight="4dp"
    android:insetBottom="6dp">
    <shape android:shape="rectangle">
        <size android:width="48dp" android:height="69.67dp" />
        <corners android:radius="8dp" />
        <solid android:color="@android:color/system_surface_container_highest_dark" />
        <stroke android:width="1dp" android:color="@android:color/system_outline_variant_dark" />
        <padding android:bottom="57.67dp" />
    </shape>
</inset>
