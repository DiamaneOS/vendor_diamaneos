     The long-press panel: a raised menu (Tally radius 12) with a hairline edge.
     Its padding (4, 2, 4 and 8 dp) is the stock drawable's.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="4dp"
    android:insetTop="2dp"
    android:insetRight="4dp"
    android:insetBottom="8dp">
    <shape android:shape="rectangle">
        <corners android:radius="12dp" />
        <solid android:color="@android:color/system_surface_container_highest_dark" />
        <stroke android:width="1dp" android:color="@android:color/system_outline_variant_dark" />
    </shape>
</inset>
