     The shift key: a keycap with a keycap LED, lit (the accent) while
     caps lock is on, unlit (the outline colour) otherwise.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@android:color/system_surface_container_low_dark" />
        </shape>
    </item>
    <item android:gravity="bottom|center_horizontal" android:width="12dp" android:height="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="1.5dp" />
            <solid android:color="@android:color/system_outline_dark" />
        </shape>
    </item>
</layer-list>
