// DiamaneOS-wide overlays, installed on the product partition for every device.
// Each is static and targets one package; the overlay check in DiamaneOS tools
// (bin/diamaneos overlays check) must pass for every change here.

runtime_resource_overlay {
    name: "DiamaneOSSettingsOverlay",
    product_specific: true,
    manifest: "DiamaneOSSettingsOverlay/AndroidManifest.xml",
    resource_dirs: ["DiamaneOSSettingsOverlay/res"],
}

// Framework (android): the Tally values from the token export
// (res/values/tally_tokens.xml, written by diamaneos-design
// design/tokens/generate.py --export framework-overlay), buttons without
// capitals, no round icons, the neutral 32-bit app text (UI-08), the key radius
// on emphasized notification actions (res/values/tally_shapes.xml), the small
// key radius on a notification's expand key (res/drawable) and the default
// wallpaper. res/drawable-nodpi/default_wallpaper.png is diamaneos-design
// design/branding/assets/wallpaper/panel-sodium-portrait-dark.png (1116 x 2484,
// the FP6 screen), exported from its SVG by design/branding/export_png.py and
// recorded in assets/png-sha256.json.
runtime_resource_overlay {
    name: "DiamaneOSFrameworkOverlay",
    product_specific: true,
    manifest: "DiamaneOSFrameworkOverlay/AndroidManifest.xml",
    resource_dirs: ["DiamaneOSFrameworkOverlay/res"],
}

// SystemUI: the Tally key radius on the stock status bar chips
// (res/values/tally_shapes.xml).
runtime_resource_overlay {
    name: "DiamaneOSSystemUIOverlay",
    product_specific: true,
    manifest: "DiamaneOSSystemUIOverlay/AndroidManifest.xml",
    resource_dirs: ["DiamaneOSSystemUIOverlay/res"],
}

// Files (DocumentsUI): Material 3 (force_material3, in its overlayable).
runtime_resource_overlay {
    name: "DiamaneOSDocumentsUIOverlay",
    product_specific: true,
    manifest: "DiamaneOSDocumentsUIOverlay/AndroidManifest.xml",
    resource_dirs: ["DiamaneOSDocumentsUIOverlay/res"],
}

// Wallpaper & style (ThemesStub): the five DiamaneOS colour presets.
runtime_resource_overlay {
    name: "DiamaneOSThemesOverlay",
    product_specific: true,
    manifest: "DiamaneOSThemesOverlay/AndroidManifest.xml",
    resource_dirs: ["DiamaneOSThemesOverlay/res"],
}

// Setup (GrapheneOS SetupWizard2): the welcome line, the tagline and the
// Pleat mark.
runtime_resource_overlay {
    name: "DiamaneOSSetupWizardOverlay",
    product_specific: true,
    manifest: "DiamaneOSSetupWizardOverlay/AndroidManifest.xml",
    resource_dirs: ["DiamaneOSSetupWizardOverlay/res"],
}
