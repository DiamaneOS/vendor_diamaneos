// DiamaneOS-wide overlays, installed on the product partition for every device.
// Each is static and targets one package; the overlay check in DiamaneOS tools
// (bin/diamaneos overlays check) must pass for every change here.

runtime_resource_overlay {
    name: "DiamaneOSSettingsOverlay",
    product_specific: true,
    manifest: "DiamaneOSSettingsOverlay/AndroidManifest.xml",
    resource_dirs: ["DiamaneOSSettingsOverlay/res"],
}

// Framework (android): the Tally values from the token export
// (res/values/tally_tokens.xml, generated from the DiamaneOS design tokens),
// buttons without capitals, no round icons, the neutral 32-bit app text, the key
// radius on emphasized notification actions (res/values/tally_shapes.xml), the
// small key radius on a notification's expand key (res/drawable) and the
// wallpapers. The default wallpaper (default_wallpaper_component) is Tally's
// Paper wallpaper in SystemUI, light or dark with the theme. The built-in
// picture, res/drawable-nodpi/default_wallpaper.png, stays the DiamaneOS Sodium
// panel wallpaper (portrait and dark, 1116 x 2484, the FP6 screen, exported from
// its SVG): Wallpaper & style offers it under On-device wallpapers, and apps
// that read the wallpaper as a picture get it.
runtime_resource_overlay {
    name: "DiamaneOSFrameworkOverlay",
    product_specific: true,
    manifest: "DiamaneOSFrameworkOverlay/AndroidManifest.xml",
    resource_dirs: ["DiamaneOSFrameworkOverlay/res"],
}

// SystemUI: the Tally key radius on the stock status bar chips
// (res/values/tally_shapes.xml).
runtime_resource_overlay {
    name: "DiamaneOSSystemUIOverlay",
    product_specific: true,
    manifest: "DiamaneOSSystemUIOverlay/AndroidManifest.xml",
    resource_dirs: ["DiamaneOSSystemUIOverlay/res"],
}

// SystemUI: Edit on a screenshot opens LineageOS's Canvas
// (config_preferredScreenshotEditor). product.mk installs it with Canvas when
// DIAMANEOS_SCREENSHOT_EDITOR is canvas.
runtime_resource_overlay {
    name: "DiamaneOSScreenshotEditorOverlay",
    product_specific: true,
    manifest: "DiamaneOSScreenshotEditorOverlay/AndroidManifest.xml",
    resource_dirs: ["DiamaneOSScreenshotEditorOverlay/res"],
}

// Files (DocumentsUI): Material 3 (force_material3, in its overlayable).
runtime_resource_overlay {
    name: "DiamaneOSDocumentsUIOverlay",
    product_specific: true,
    manifest: "DiamaneOSDocumentsUIOverlay/AndroidManifest.xml",
    resource_dirs: ["DiamaneOSDocumentsUIOverlay/res"],
}

// Wallpaper & style (ThemesStub): the five DiamaneOS colour presets.
runtime_resource_overlay {
    name: "DiamaneOSThemesOverlay",
    product_specific: true,
    manifest: "DiamaneOSThemesOverlay/AndroidManifest.xml",
    resource_dirs: ["DiamaneOSThemesOverlay/res"],
}

// Setup (GrapheneOS SetupWizard2): the welcome line, the tagline, the
// restore text and the Pleat mark.
runtime_resource_overlay {
    name: "DiamaneOSSetupWizardOverlay",
    product_specific: true,
    manifest: "DiamaneOSSetupWizardOverlay/AndroidManifest.xml",
    resource_dirs: ["DiamaneOSSetupWizardOverlay/res"],
}

// Speech Services (GrapheneOS's presigned text-to-speech app): its name
// without GrapheneOS's.
runtime_resource_overlay {
    name: "DiamaneOSSpeechServicesOverlay",
    product_specific: true,
    manifest: "DiamaneOSSpeechServicesOverlay/AndroidManifest.xml",
    resource_dirs: ["DiamaneOSSpeechServicesOverlay/res"],
}
