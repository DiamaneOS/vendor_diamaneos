<resources>
    <!-- Security > Duress password. Unchanged but for the name. -->
    <string name="duress_pwd_description">"Duress password can be entered instead of the user password in any place that asks for it, such as the lock screen of any user and any user or work profile password prompt.

Submitting the duress password will immediately make the storage contents permanently inaccessible, delete all eSIMs and then power off the device. DiamaneOS will remain installed.

Duress PIN works the same way duress password does."</string>

    <!-- App info > Exploit protection, the compatibility mode switch.
         Unchanged but for the name. -->
    <string name="aep_compat_mode_summary">Improves compatibility by disabling some of the DiamaneOS exploit protections for this app</string>

    <!-- App info > Play Integrity API. GrapheneOS's text names it four
         times and states which integrity level it passes, that apps ban it and
         what hardware attestation verifies. None of that has been tested on
         DiamaneOS on the FP6, so this says only what the API is for and what
         a user can do. New, reviewed text. -->
    <!-- Location and Network: the default server choices go to the DiamaneOS
         servers (frameworks/base, Connectivity and NetworkLocation forks), so
         they name DiamaneOS. Connectivity checks keep GrapheneOS's label: the
         NetworkStack and DnsResolver modules still use GrapheneOS's servers. -->
    <string name="supl_enabled_grapheneos_proxy">DiamaneOS proxy</string>
    <string name="psds_enabled_grapheneos_server">DiamaneOS server</string>
    <string name="network_location_enabled_grapheneos_apple_proxy">DiamaneOS Apple proxy</string>
    <string name="remote_provisioning_enabled_grapheneos_proxy">DiamaneOS proxy</string>
    <string name="widevine_provisioning_enabled_grapheneos_proxy">DiamaneOS proxy</string>
    <string name="cert_transparency_dl_grapheneos_server">DiamaneOS server</string>

    <string name="app_play_integrity_top_intro">The Play Integrity API allows services to verify properties of a device through their app. Some services accept only the operating system that the device was sold with, so their apps may not work on DiamaneOS. If an app does not work, you can contact its developer.</string>
</resources>
