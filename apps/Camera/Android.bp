android_app_import {
    name: "Camera",
    product_specific: true,

    apk: "prebuilt/app-release.apk",
    preprocessed: true,

    optional_uses_libs: ["androidx.camera.extensions.impl"],

    required: ["CameraProcessor"],
}

// Camera's preview processor. Its preview service is guarded by a signature permission
// the Camera holds, so both carry the Camera certificate.
android_app_import {
    name: "CameraProcessor",
    product_specific: true,

    apk: "prebuilt/processor-release.apk",
    preprocessed: true,
}
