// Sofia Sans Tally, the metric-adjusted Sofia Sans, as the system font:
// sans-serif and the two named families the Tally shell uses
// (fonts_customization.xml). tools/build_tally_fonts.py builds the installed
// fonts from the unmodified upstream files beside them (source.json records
// both, with their SHA-256); the upstream files are its input and are not
// installed. All are under the SIL Open Font License 1.1 (OFL.txt).

license {
    name: "vendor_diamaneos_fonts_sofia_sans_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-OFL-1.1"],
    license_text: ["OFL.txt"],
}

prebuilt_font {
    name: "SofiaSansTally-Regular.ttf",
    src: "SofiaSansTally-Regular.ttf",
    product_specific: true,
    licenses: ["vendor_diamaneos_fonts_sofia_sans_license"],
}

prebuilt_font {
    name: "SofiaSansTally-Italic.ttf",
    src: "SofiaSansTally-Italic.ttf",
    product_specific: true,
    licenses: ["vendor_diamaneos_fonts_sofia_sans_license"],
}

prebuilt_font {
    name: "SofiaSansTallySemiCondensed-Regular.ttf",
    src: "SofiaSansTallySemiCondensed-Regular.ttf",
    product_specific: true,
    licenses: ["vendor_diamaneos_fonts_sofia_sans_license"],
}

prebuilt_font {
    name: "SofiaSansTallySemiCondensed-Italic.ttf",
    src: "SofiaSansTallySemiCondensed-Italic.ttf",
    product_specific: true,
    licenses: ["vendor_diamaneos_fonts_sofia_sans_license"],
}

// /product/etc/fonts_customization.xml, with the fonts it names.
prebuilt_etc {
    name: "DiamaneOSFontsCustomization",
    src: "fonts_customization.xml",
    filename: "fonts_customization.xml",
    product_specific: true,
    required: [
        "SofiaSansTally-Italic.ttf",
        "SofiaSansTally-Regular.ttf",
        "SofiaSansTallySemiCondensed-Italic.ttf",
        "SofiaSansTallySemiCondensed-Regular.ttf",
    ],
}
